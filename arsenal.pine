//@version=5
indicator("NQ/ES Arsenal [Antigravity]", shorttitle="Arsenal", overlay=true,
     max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=500)

// ═══════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═══════════════════════════════════════════════════════════════════════════════
string grpVWAP = "① VWAP Bands"
bool   showVWAP   = input.bool(true, "Show VWAP + Bands", group=grpVWAP)
float  bandMult1  = input.float(1.0, "Band 1 σ Multiplier", minval=0.5, maxval=3.0, step=0.5, group=grpVWAP)
float  bandMult2  = input.float(2.0, "Band 2 σ Multiplier", minval=1.0, maxval=4.0, step=0.5, group=grpVWAP)

string grpSL = "② Session Levels"
bool   showSL     = input.bool(true, "Show PDH / PDL / PDC / Overnight", group=grpSL)

string grpEMA = "③ EMA Trend Ribbon"
bool   showEMA    = input.bool(true, "Show EMA Ribbon", group=grpEMA)
int    lenFast    = input.int(8, "Fast EMA", minval=2, maxval=50, group=grpEMA)
int    lenMid     = input.int(21, "Mid EMA", minval=5, maxval=100, group=grpEMA)
int    lenSlow    = input.int(55, "Slow EMA", minval=10, maxval=200, group=grpEMA)

string grpFVG = "④ Fair Value Gaps"
bool   showFVG    = input.bool(true, "Show FVGs", group=grpFVG)
int    maxFVG     = input.int(8, "Max Active FVGs", minval=1, maxval=20, group=grpFVG)
float  minFVGMult = input.float(0.25, "Min FVG Size (× ATR)", minval=0.0, maxval=1.0, step=0.05, group=grpFVG)

string grpKZ = "⑤ Session Window"
bool   showKZ     = input.bool(true, "Show Session Backgrounds", group=grpKZ)

string grpSig = "⑥ Entry Signal"
float  adxThresh  = input.float(20.0, "ADX Trend Threshold", minval=10.0, maxval=40.0, step=1.0, group=grpSig,
     tooltip="ADX above this = trending (entry allowed). Optimized: 20.")
float  rsiPBThresh = input.float(50.0, "RSI Pullback Threshold", minval=35, maxval=60, group=grpSig,
     tooltip="Long: RSI ≤ this. Short: RSI ≥ (100 - this). Optimized: 50.")
int    pbMemory   = input.int(5, "Pullback Memory (bars)", minval=1, maxval=20, group=grpSig,
     tooltip="Price must have touched EMA21 or VWAP within the last N bars.")
float  atrSlMult  = input.float(3.0, "SL Distance (× ATR)", minval=1.0, maxval=5.0, step=0.5, group=grpSig,
     tooltip="Stop Loss distance. Optimized: 3.0.")
float  trendRR    = input.float(3.0, "R:R Ratio", minval=1.0, maxval=10.0, step=0.5, group=grpSig,
     tooltip="Take Profit = SL × this. Optimized: 3.0.")
bool   showSLTP   = input.bool(true, "Draw SL/TP Lines on Entry", group=grpSig)

string grpDash = "⑦ Dashboard"
bool   showDash   = input.bool(true, "Show Confluence Dashboard", group=grpDash)

string grpPO3 = "⑧ PO3 HTF Candle Projection"
bool   showPO3      = input.bool(true, "Show PO3 HTF Candles", group=grpPO3)
string po3TF        = input.timeframe("60", "HTF Candle Timeframe", group=grpPO3, tooltip="Must be higher than the chart timeframe.")
int    po3Count     = input.int(3, "Number of Candles", minval=1, maxval=10, group=grpPO3, tooltip="Includes the forming candle. 3 = forming candle + the previous 2.")
int    po3Offset    = input.int(10, "Offset (bars right of last bar)", minval=0, maxval=100, group=grpPO3)
int    po3Width     = input.int(4, "Candle Width (bars)", minval=1, maxval=20, group=grpPO3)
int    po3Gap       = input.int(2, "Gap Between Candles (bars)", minval=0, maxval=10, group=grpPO3)
bool   po3ShowTimer = input.bool(true, "Show Close Time + Countdown", group=grpPO3)
bool   po3ShowRange = input.bool(true, "Show Range", group=grpPO3)
bool   po3ShowOpen  = input.bool(true, "Show HTF Open Line", group=grpPO3)
string po3TZ        = input.string("America/New_York", "Time Zone for Times", group=grpPO3)

string grpCISD = "⑨ 1m CISD Confirmation"
bool   showCISD    = input.bool(true, "Enable CISD Check", group=grpCISD)
string cisdTF      = input.timeframe("1", "CISD Timeframe", group=grpCISD, tooltip="Must be equal to or lower than the chart timeframe.")
float  cisdAdxMin   = input.float(24.0, "Type A (shallow) needs Trend (ADX) ≥", minval=10.0, maxval=60.0, step=1.0, group=grpCISD, tooltip="Type A (shallow): price was beyond the 1st band within the lookback below AND Trend is at or above this value. CISD is then checked after price enters the ribbon (EMA 8 touch). Otherwise it is Type B (deep).")
int    cisdExtBars  = input.int(24, "Beyond-1st-Band Lookback (chart bars)", minval=1, maxval=200, group=grpCISD)
bool   cisdReqRej   = input.bool(true, "Type B (deep): Require Pattern-CISD + Close Outside Ribbon", group=grpCISD, tooltip="Deep pullbacks (EMA 21 or EMA 55 touched) only confirm when (1) a 1m candlestick pattern generates the CISD, i.e. the pattern's completing 1m candle is the CISD candle, and (2) a chart-timeframe candle body then closes outside the ribbon. Both must happen after the touch.")
bool   cisdReqRejA  = input.bool(false, "Type A (shallow): Also Require Pattern-CISD + Close Outside", group=grpCISD, tooltip="Off = shallow entries confirm on the plain 1m CISD alone.")
bool   patSingle    = input.bool(true, "Patterns: Single-Candle", group=grpCISD, tooltip="Hammer, Inverted Hammer, Dragonfly Doji, Bullish/Bearish Belt Hold, Hanging Man, Shooting Star.")
bool   patDouble    = input.bool(true, "Patterns: Two-Candle", group=grpCISD, tooltip="Bullish/Bearish Engulfing, Piercing Line, Dark Cloud Cover, Harami, Kicker, Tweezer Bottom/Top, Separating Lines, Meeting Lines, Bearish Doji Star.")
bool   patTriple    = input.bool(true, "Patterns: Three-Candle", group=grpCISD, tooltip="Morning Star, Evening Star, Three White Soldiers, Three Black Crows, Abandoned Baby, Three Inside Up/Down, Three Outside Up/Down, Upside Gap Two Crows.")
bool   patMulti     = input.bool(true, "Patterns: Four/Five-Candle", group=grpCISD, tooltip="Rising Three Methods, Mat Hold (bullish and bearish), Three-Line Strike (bullish and bearish), Ladder Bottom, Concealing Baby Swallow.")
float  patLong      = input.float(1.0, "Pattern: Long Candle = Body ≥ × Avg Body", minval=0.5, maxval=2.5, step=0.1, group=grpCISD, tooltip="Average body = 14-bar average.")
float  patSmall     = input.float(0.5, "Pattern: Small Candle = Body ≤ × Avg Body", minval=0.1, maxval=1.0, step=0.1, group=grpCISD)
string outMode      = input.string("Close", "Chart-TF Candle Counts As Outside When", options=["Close", "Whole Body"], group=grpCISD, tooltip="Close = the candle CLOSE is beyond the whole ribbon (above EMA 8/21/55 for longs, below for shorts). Whole Body = open and close are both beyond it.")
float  rejWick      = input.float(0.55, "Pin: Min Wick Share of Candle Range", minval=0.3, maxval=0.9, step=0.05, group=grpCISD)
float  rejBody      = input.float(0.35, "Pin: Max Body Share of Candle Range", minval=0.1, maxval=0.6, step=0.05, group=grpCISD)
int    cisdMinRun  = input.int(2, "Min Consecutive Delivery Candles", minval=1, maxval=6, group=grpCISD, tooltip="Bullish CISD: after at least this many down-closing candles, a close above the OPEN of the first down candle. Bearish CISD is the mirror.")
int    cisdWindow  = input.int(6, "Valid Window After Ribbon Touch (chart bars)", minval=1, maxval=30, group=grpCISD)

string grpHTF = "⑩ HTF FVG Delivery"
bool   showHTF     = input.bool(true, "Enable HTF Delivery Check", group=grpHTF)
bool   htfOn1      = input.bool(true, "TF 1", inline="h1", group=grpHTF)
string htfTF1      = input.timeframe("15", "", inline="h1", group=grpHTF)
bool   htfOn2      = input.bool(true, "TF 2", inline="h2", group=grpHTF)
string htfTF2      = input.timeframe("30", "", inline="h2", group=grpHTF)
bool   htfOn3      = input.bool(true, "TF 3", inline="h3", group=grpHTF)
string htfTF3      = input.timeframe("60", "", inline="h3", group=grpHTF)
bool   htfOn4      = input.bool(true, "TF 4", inline="h4", group=grpHTF)
string htfTF4      = input.timeframe("240", "", inline="h4", group=grpHTF)
bool   htfOn5      = input.bool(true, "TF 5", inline="h5", group=grpHTF)
string htfTF5      = input.timeframe("D", "", inline="h5", group=grpHTF)
string htfFill     = input.string("Body", "Zone Is Dead When", options=["Body", "Wick"], group=grpHTF, tooltip="Body = dead only when an HTF candle CLOSES beyond the far edge of the gap (wicks through it are ignored). Wick = dead as soon as price trades fully through it.")
int    htfAccBars  = input.int(2000, "Accelerator Max Age (chart bars)", minval=10, maxval=20000, group=grpHTF, tooltip="A gap only counts as the current / previous accelerator if price was last inside it within this many chart bars (2000 5m bars is roughly 7 trading days).")
int    htfMaxZones = input.int(6, "Max Zones Per Timeframe", minval=1, maxval=20, group=grpHTF)
bool   htfDraw     = input.bool(true, "Draw HTF FVG Boxes", group=grpHTF)

string grpCol = "⑪ Colors (PO3 / CISD / HTF)"
color  cPo3UpBody    = input.color(#4F86F7, "PO3 Bull Candle: Body", group=grpCol)
color  cPo3UpBorder  = input.color(#4F86F7, "PO3 Bull Candle: Border", group=grpCol)
color  cPo3UpWick    = input.color(#4F86F7, "PO3 Bull Candle: Wick", group=grpCol)
color  cPo3DnBody    = input.color(#5C6070, "PO3 Bear Candle: Body", group=grpCol)
color  cPo3DnBorder  = input.color(#5C6070, "PO3 Bear Candle: Border", group=grpCol)
color  cPo3DnWick    = input.color(#5C6070, "PO3 Bear Candle: Wick", group=grpCol)
color  cPo3Open      = input.color(color.new(color.gray, 20), "PO3 HTF Open Line", group=grpCol)
color  cPo3TimeTxt   = input.color(color.new(color.gray, 10), "PO3 Candle Time Text", group=grpCol)
color  cPo3LblBg     = input.color(color.new(color.gray, 25), "PO3 Info Label: Background", group=grpCol)
color  cPo3LblTxt    = input.color(color.white, "PO3 Info Label: Text", group=grpCol)
color  cCisdOnL      = input.color(color.new(color.green, 15), "CISD Row: Confirmed Long", group=grpCol)
color  cCisdOnS      = input.color(color.new(color.green, 15), "CISD Row: Confirmed Short", group=grpCol)
color  cCisdWait     = input.color(color.new(color.orange, 40), "CISD Row: Waiting (in ribbon)", group=grpCol)
color  cCisdIdle     = input.color(color.new(color.gray, 70), "CISD Row: Idle", group=grpCol)
color  cCisdTxt      = input.color(color.white, "CISD Row: Text", group=grpCol)
color  cHtfBull      = input.color(color.new(color.teal, 30), "FVG Rows: Bullish & Aligned With Bias", group=grpCol)
color  cHtfBear      = input.color(color.new(color.red, 30), "FVG Rows: Bearish & Aligned With Bias", group=grpCol)
color  cHtfMix       = input.color(color.new(color.orange, 40), "FVG Rows: Against Bias / Neutral", group=grpCol)
color  cHtfNone      = input.color(color.new(color.gray, 70), "FVG Rows: None", group=grpCol)
color  cHtfTxt       = input.color(color.white, "FVG Rows: Text", group=grpCol)
color  cHtfBullFill  = input.color(color.new(color.lime, 90), "HTF FVG Box: Bull Fill", group=grpCol)
color  cHtfBullBrd   = input.color(color.new(color.lime, 60), "HTF FVG Box: Bull Border", group=grpCol)
color  cHtfBearFill  = input.color(color.new(color.orange, 90), "HTF FVG Box: Bear Fill", group=grpCol)
color  cHtfBearBrd   = input.color(color.new(color.orange, 60), "HTF FVG Box: Bear Border", group=grpCol)
color  cHtfBoxTxt    = input.color(color.new(color.white, 30), "HTF FVG Box: Label Text", group=grpCol)
color  cExtraFull    = input.color(color.new(color.teal, 20), "EXTRA Row: All Confluences", group=grpCol)
color  cExtraPart    = input.color(color.new(color.orange, 40), "EXTRA Row: Some Confluences", group=grpCol)
color  cExtraNone    = input.color(color.new(color.gray, 70), "EXTRA Row: None", group=grpCol)
color  cExtraTxt     = input.color(color.white, "EXTRA Row: Text", group=grpCol)


// ═══════════════════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════
string mktTZ = "America/New_York"

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 1 — VWAP + STANDARD DEVIATION BANDS
// ═══════════════════════════════════════════════════════════════════════════════
bool  newSession = ta.change(time("D")) != 0
float typPrice   = hlc3
float vol        = nz(volume, 1.0)

var float sumPV   = 0.0
var float sumV    = 0.0
var float sumPV2  = 0.0

if newSession
    sumPV  := typPrice * vol
    sumV   := vol
    sumPV2 := typPrice * typPrice * vol
else
    sumPV  += typPrice * vol
    sumV   += vol
    sumPV2 += typPrice * typPrice * vol

float vwapLine = sumV > 0 ? sumPV / sumV : close
float vwapVar  = sumV > 0 ? math.max((sumPV2 / sumV) - vwapLine * vwapLine, 0.0) : 0.0
float vwapSD   = math.sqrt(vwapVar)

float upper1 = vwapLine + vwapSD * bandMult1
float upper2 = vwapLine + vwapSD * bandMult2
float lower1 = vwapLine - vwapSD * bandMult1
float lower2 = vwapLine - vwapSD * bandMult2

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 2 — SESSION LEVELS (PDH / PDL / PDC + Overnight High / Low)
// ═══════════════════════════════════════════════════════════════════════════════
float pdh = request.security(syminfo.tickerid, "D", high[1],  gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float pdl = request.security(syminfo.tickerid, "D", low[1],   gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
float pdc = request.security(syminfo.tickerid, "D", close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

// Overnight (Globex) High / Low — tracked during non-RTH hours, frozen at RTH open
bool isRTH = not na(time(timeframe.period, "0930-1600", mktTZ))

var float onH         = na
var float onL         = na
var float frozenONH   = na
var float frozenONL   = na
var bool  prevRTH     = false

if isRTH and not prevRTH
    frozenONH := onH
    frozenONL := onL
if not isRTH and prevRTH
    onH := high
    onL := low
if not isRTH and not prevRTH and bar_index > 0
    onH := math.max(nz(onH, high), high)
    onL := math.min(nz(onL, low), low)

prevRTH := isRTH

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 3 — EMA TREND RIBBON (8 / 21 / 55)
// ═══════════════════════════════════════════════════════════════════════════════
float ema8  = ta.ema(close, lenFast)
float ema21 = ta.ema(close, lenMid)
float ema55 = ta.ema(close, lenSlow)

bool bullTrend = ema8 > ema21 and close > ema55
bool bearTrend = ema8 < ema21 and close < ema55

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 4 — FAIR VALUE GAPS (FVGs)
// ═══════════════════════════════════════════════════════════════════════════════
float atrVal = ta.atr(14)
float minGap = nz(atrVal, 1.0) * minFVGMult

bool bullGap = low > high[2] and (low - high[2]) >= minGap
bool bearGap = high < low[2] and (low[2] - high) >= minGap

var box[]   fvgBox = array.new_box()
var int[]   fvgDir = array.new_int()
var float[] fvgHi  = array.new_float()
var float[] fvgLo  = array.new_float()

// Clean filled FVGs
if array.size(fvgBox) > 0
    for i = array.size(fvgBox) - 1 to 0
        int   d = array.get(fvgDir, i)
        float h = array.get(fvgHi, i)
        float l = array.get(fvgLo, i)
        bool  filled = (d == 1 and low <= h) or (d == -1 and high >= l)
        if filled
            box.delete(array.get(fvgBox, i))
            array.remove(fvgBox, i)
            array.remove(fvgDir, i)
            array.remove(fvgHi, i)
            array.remove(fvgLo, i)

// Add new bullish FVG
if showFVG and bullGap
    if array.size(fvgBox) >= maxFVG
        box.delete(array.get(fvgBox, 0))
        array.remove(fvgBox, 0)
        array.remove(fvgDir, 0)
        array.remove(fvgHi, 0)
        array.remove(fvgLo, 0)
    float gapT = low
    float gapB = high[2]
    array.push(fvgBox, box.new(bar_index[2], gapT, bar_index, gapB,
         border_color=color.new(color.teal, 70), bgcolor=color.new(color.teal, 92), extend=extend.right))
    array.push(fvgDir, 1)
    array.push(fvgHi, gapT)
    array.push(fvgLo, gapB)

// Add new bearish FVG
if showFVG and bearGap
    if array.size(fvgBox) >= maxFVG
        box.delete(array.get(fvgBox, 0))
        array.remove(fvgBox, 0)
        array.remove(fvgDir, 0)
        array.remove(fvgHi, 0)
        array.remove(fvgLo, 0)
    float gapT = low[2]
    float gapB = high
    array.push(fvgBox, box.new(bar_index[2], gapT, bar_index, gapB,
         border_color=color.new(color.red, 70), bgcolor=color.new(color.red, 92), extend=extend.right))
    array.push(fvgDir, -1)
    array.push(fvgHi, gapT)
    array.push(fvgLo, gapB)

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 5 — SESSION WINDOWS
// ═══════════════════════════════════════════════════════════════════════════════
bool inNYOpen    = not na(time(timeframe.period, "0930-1100", mktTZ))
bool inPowerHour = not na(time(timeframe.period, "1500-1600", mktTZ))
bool inFullRTH   = not na(time(timeframe.period, "0930-1600", mktTZ))
bool inKillZone  = inNYOpen or inPowerHour

// ═══════════════════════════════════════════════════════════════════════════════
// METRICS — RSI + ADX
// ═══════════════════════════════════════════════════════════════════════════════
float rsiVal = ta.rsi(close, 14)
[diP, diM, adxVal] = ta.dmi(14, 14)
bool isTrending = adxVal > adxThresh

// ═══════════════════════════════════════════════════════════════════════════════
// PULLBACK MEMORY — Did price touch EMA21 or VWAP recently?
// ═══════════════════════════════════════════════════════════════════════════════
bool touchedLong  = close <= ema21 or close <= vwapLine
bool touchedShort = close >= ema21 or close >= vwapLine

float pbLongSum  = math.sum(touchedLong  ? 1.0 : 0.0, pbMemory)
float pbShortSum = math.sum(touchedShort ? 1.0 : 0.0, pbMemory)

bool pbLongRecent  = pbLongSum > 0
bool pbShortRecent = pbShortSum > 0

// ═══════════════════════════════════════════════════════════════════════════════
// ENTRY SIGNAL — Trend-Only Pullback (matches Edge strategy exactly)
// ═══════════════════════════════════════════════════════════════════════════════
bool sigLong = isTrending
     and bullTrend
     and pbLongRecent
     and rsiVal <= rsiPBThresh
     and close > open
     and inFullRTH

bool sigShort = isTrending
     and bearTrend
     and pbShortRecent
     and rsiVal >= (100 - rsiPBThresh)
     and close < open
     and inFullRTH

// ═══════════════════════════════════════════════════════════════════════════════
// LAYER 6 — PO3 HTF CANDLES / 1m CISD / HTF FVG DELIVERY
// ═══════════════════════════════════════════════════════════════════════════════

int chartSec = timeframe.in_seconds()

// ── Helpers ──────────────────────────────────────────────────────────────────
f_tfName(string tf) =>
    int s = timeframe.in_seconds(tf)
    string r = s < 3600 ? str.tostring(math.round(s / 60.0)) + "m" : s < 86400 ? str.tostring(math.round(s / 3600.0)) + "H" : s < 604800 ? str.tostring(math.round(s / 86400.0)) + "D" : str.tostring(math.round(s / 604800.0)) + "W"
    r

f_fmtRem(int sec) =>
    int hh = math.floor(sec / 3600)
    int mm = math.floor((sec % 3600) / 60)
    int ss = sec % 60
    (hh > 0 ? str.tostring(hh) + ":" : "") + str.tostring(mm, "00") + ":" + str.tostring(ss, "00")

// 1m candlestick pattern engine: candle 0 = newest, 1 = previous ... 4 = oldest. Returns the first matching pattern name for the requested direction.
f_pat(bool wantBull, float o0, float h0, float l0, float c0, float o1, float h1, float l1, float c1, float o2, float h2, float l2, float c2, float o3, float h3, float l3, float c3, float o4, float h4, float l4, float c4, float avgB, float tol, bool dS, bool dD, bool dT, bool dM, float wick, float bodyMx, float lng, float sml) =>
    float b0 = math.abs(c0 - o0)
    float b1 = math.abs(c1 - o1)
    float b2 = math.abs(c2 - o2)
    float b3 = math.abs(c3 - o3)
    float b4 = math.abs(c4 - o4)
    bool bu0 = c0 > o0
    bool bu1 = c1 > o1
    bool bu2 = c2 > o2
    bool bu3 = c3 > o3
    bool bu4 = c4 > o4
    bool be0 = c0 < o0
    bool be1 = c1 < o1
    bool be2 = c2 < o2
    bool be3 = c3 < o3
    bool be4 = c4 < o4
    bool lg0 = b0 >= lng * avgB
    bool lg1 = b1 >= lng * avgB
    bool lg2 = b2 >= lng * avgB
    bool lg3 = b3 >= lng * avgB
    bool lg4 = b4 >= lng * avgB
    bool sm0 = b0 <= sml * avgB
    bool sm1 = b1 <= sml * avgB
    bool sm2 = b2 <= sml * avgB
    bool sm3 = b3 <= sml * avgB
    float r0 = h0 - l0
    float r1 = h1 - l1
    float up0 = h0 - math.max(o0, c0)
    float dn0 = math.min(o0, c0) - l0
    bool dj0 = r0 > 0 and b0 <= 0.1 * r0
    bool dj1 = r1 > 0 and b1 <= 0.1 * r1
    float mid1 = (o1 + c1) / 2
    float mid2 = (o2 + c2) / 2
    float top0 = math.max(o0, c0)
    float bot0 = math.min(o0, c0)
    float top1 = math.max(o1, c1)
    float bot1 = math.min(o1, c1)
    bool wDn = r0 > 0 and dn0 >= wick * r0 and b0 <= bodyMx * r0
    bool wUp = r0 > 0 and up0 >= wick * r0 and b0 <= bodyMx * r0
    string r = ""
    if wantBull
        bool bEng     = be1 and bu0 and b0 > b1 and c0 >= o1 and o0 <= c1
        bool bHammer  = wDn
        bool bMorn    = be2 and lg2 and sm1 and bot1 <= c2 and bu0 and lg0 and c0 > mid2
        bool bPierce  = be1 and lg1 and bu0 and o0 <= c1 and c0 > mid1 and c0 < o1
        bool bHarami  = be1 and lg1 and bu0 and sm0 and top0 <= o1 and bot0 >= c1
        bool bSoldier = bu0 and bu1 and bu2 and lg0 and lg1 and lg2 and o1 > o2 and o1 < c2 and o0 > o1 and o0 < c1 and c0 > c1 and c1 > c2 and (h0 - c0) <= 0.35 * b0 and (h1 - c1) <= 0.35 * b1 and (h2 - c2) <= 0.35 * b2
        bool bInvH    = wUp and dn0 <= 0.25 * r0
        bool bDragon  = dj0 and dn0 >= 0.6 * r0 and up0 <= 0.1 * r0
        bool bAband   = be2 and lg2 and dj1 and top1 < c2 and bu0 and lg0 and o0 > top1
        bool bInUp    = be2 and lg2 and bu1 and top1 <= o2 and bot1 >= c2 and c1 > mid2 and bu0 and c0 > o2
        bool bOutUp   = be2 and bu1 and c1 >= o2 and o1 <= c2 and bu0 and c0 > c1
        bool bKick    = be1 and lg1 and bu0 and lg0 and o0 >= o1 and b0 > b1
        bool bTwzB    = be1 and bu0 and math.abs(l0 - l1) <= tol
        bool bRTM     = bu4 and lg4 and be3 and be2 and be1 and sm3 and sm2 and sm1 and h3 <= h4 and h2 <= h4 and h1 <= h4 and l3 >= l4 and l2 >= l4 and l1 >= l4 and bu0 and lg0 and c0 > h4
        bool bSwallow = be3 and be2 and lg3 and lg2 and top1 < c2 and sm1 and be0 and lg0 and h0 >= h1 and l0 <= l1
        bool bMatHold = bu4 and lg4 and sm3 and sm2 and sm1 and c2 < c3 and c1 < c2 and h3 <= h4 and h2 <= h4 and h1 <= h4 and l3 >= l4 and l2 >= l4 and l1 >= l4 and bu0 and lg0 and c0 > h4
        bool bSepLn   = be1 and bu0 and lg0 and math.abs(o0 - o1) <= tol
        bool bBelt    = bu0 and lg0 and dn0 <= 0.1 * r0 and up0 <= 0.25 * r0
        bool b3Strike = bu3 and bu2 and bu1 and c2 > c3 and c1 > c2 and be0 and lg0 and o0 >= c1 and c0 < o3
        bool bLadder  = be4 and be3 and be2 and lg4 and lg3 and lg2 and c3 < c4 and c2 < c3 and sm1 and bu0 and lg0
        bool bMeet    = be1 and lg1 and bu0 and lg0 and o0 < c1 and math.abs(c0 - c1) <= tol
        if dD and bEng
            r := "Bull Engulfing"
        else if dS and bHammer
            r := "Hammer"
        else if dT and bMorn
            r := "Morning Star"
        else if dD and bPierce
            r := "Piercing Line"
        else if dD and bHarami
            r := "Bull Harami"
        else if dT and bSoldier
            r := "3 White Soldiers"
        else if dS and bInvH
            r := "Inverted Hammer"
        else if dS and bDragon
            r := "Dragonfly Doji"
        else if dT and bAband
            r := "Bull Abandoned Baby"
        else if dT and bInUp
            r := "3 Inside Up"
        else if dT and bOutUp
            r := "3 Outside Up"
        else if dD and bKick
            r := "Bull Kicker"
        else if dD and bTwzB
            r := "Tweezer Bottom"
        else if dM and bRTM
            r := "Rising 3 Methods"
        else if dM and bSwallow
            r := "Baby Swallow"
        else if dM and bMatHold
            r := "Mat Hold"
        else if dD and bSepLn
            r := "Separating Lines"
        else if dS and bBelt
            r := "Bull Belt Hold"
        else if dM and b3Strike
            r := "3-Line Strike"
        else if dM and bLadder
            r := "Ladder Bottom"
        else if dD and bMeet
            r := "Meeting Lines"
    else
        bool sEng      = bu1 and be0 and b0 > b1 and o0 >= c1 and c0 <= o1
        bool sBelt     = be0 and lg0 and up0 <= 0.1 * r0 and dn0 <= 0.25 * r0
        bool sCrows    = be0 and be1 and be2 and lg0 and lg1 and lg2 and o1 < o2 and o1 > c2 and o0 < o1 and o0 > c1 and c0 < c1 and c1 < c2 and (c0 - l0) <= 0.35 * b0 and (c1 - l1) <= 0.35 * b1 and (c2 - l2) <= 0.35 * b2
        bool s3Strike  = be3 and be2 and be1 and c2 < c3 and c1 < c2 and bu0 and lg0 and o0 <= c1 and c0 > o3
        bool sHang     = wDn
        bool sGap2     = bu2 and lg2 and be1 and bot1 > c2 and be0 and o0 >= o1 and c0 < c1
        bool sEve      = bu2 and lg2 and sm1 and top1 >= c2 and be0 and lg0 and c0 < mid2
        bool sShoot    = wUp and dn0 <= 0.25 * r0
        bool sHarami   = bu1 and lg1 and be0 and sm0 and top0 <= c1 and bot0 >= o1
        bool sDojiStar = bu1 and lg1 and dj0 and bot0 >= c1 - tol
        bool sAband    = bu2 and lg2 and dj1 and bot1 > c2 and be0 and lg0 and o0 < bot1
        bool sTwzT     = bu1 and be0 and math.abs(h0 - h1) <= tol
        bool sKick     = bu1 and lg1 and be0 and lg0 and o0 <= o1 and c0 < c1
        bool s3InDn    = bu2 and lg2 and be1 and top1 <= c2 and bot1 >= o2 and be0 and c0 < o2
        bool s3OutDn   = bu2 and be1 and o1 >= c2 and c1 <= o2 and be0 and c0 < c1
        bool sMat      = be4 and lg4 and bu3 and bu2 and bu1 and sm3 and sm2 and sm1 and h3 <= h4 and h2 <= h4 and h1 <= h4 and l3 >= l4 and l2 >= l4 and l1 >= l4 and be0 and lg0 and c0 < l4
        bool sDark     = bu1 and lg1 and be0 and o0 >= c1 and c0 < mid1 and c0 > o1
        if dD and sEng
            r := "Bear Engulfing"
        else if dS and sBelt
            r := "Bear Belt Hold"
        else if dT and sCrows
            r := "3 Black Crows"
        else if dM and s3Strike
            r := "Bear 3-Line Strike"
        else if dS and sHang
            r := "Hanging Man"
        else if dT and sGap2
            r := "Gap 2 Crows"
        else if dT and sEve
            r := "Evening Star"
        else if dS and sShoot
            r := "Shooting Star"
        else if dD and sHarami
            r := "Bear Harami"
        else if dD and sDojiStar
            r := "Doji Star"
        else if dT and sAband
            r := "Bear Abandoned Baby"
        else if dD and sTwzT
            r := "Tweezer Top"
        else if dD and sKick
            r := "Bear Kicker"
        else if dT and s3InDn
            r := "3 Inside Down"
        else if dT and s3OutDn
            r := "3 Outside Down"
        else if dM and sMat
            r := "Bear Mat Hold"
        else if dD and sDark
            r := "Dark Cloud Cover"
    r

// Accelerator ranking: the gap price was most recently inside wins; ties go to the higher timeframe
f_accBetter(int[] zTap, int[] zId, int[] secs, int i, int j) =>
    int  ti = array.get(zTap, i)
    int  tj = array.get(zTap, j)
    bool r  = ti > tj
    if ti == tj
        r := array.get(secs, array.get(zId, i)) > array.get(secs, array.get(zId, j))
    r

// Adds a new HTF FVG (from the last 3 completed HTF candles) when a new HTF candle opens
f_htfAdd(bool on, string tf, int id, string nm, float hA, float lA, float hB, float lB, int[] zId, int[] zDir, float[] zTop, float[] zBot, int[] zTap, box[] zBox, bool draw, int maxZ, color cBF, color cBB, color cRF, color cRB, color cTx, float cl, bool bodyMode) =>
    int  t      = nz(time(tf), 0)
    bool newBar = t != nz(t[1], 0)
    if on and newBar and not na(hA) and not na(lA) and not na(hB) and not na(lB)
        // Body mode: the HTF candle that just closed kills any gap its CLOSE went through
        if bodyMode and not na(cl) and array.size(zId) > 0
            for i = array.size(zId) - 1 to 0
                if array.get(zId, i) == id
                    int   zdk = array.get(zDir, i)
                    float ztk = array.get(zTop, i)
                    float zbk = array.get(zBot, i)
                    bool  deadK = (zdk == 1 and cl < zbk) or (zdk == -1 and cl > ztk)
                    if deadK
                        box.delete(array.get(zBox, i))
                        array.remove(zId, i)
                        array.remove(zDir, i)
                        array.remove(zTop, i)
                        array.remove(zBot, i)
                        array.remove(zTap, i)
                        array.remove(zBox, i)
        float minG  = nz(atrVal, 1.0) * minFVGMult
        bool  added = false
        // Bullish gap: low of newest candle above high of the candle 2 before it
        if lA > hB and (lA - hB) >= minG
            box nb = na
            if draw
                nb := box.new(bar_index, lA, bar_index + 1, hB, border_color=cBB, bgcolor=cBF, extend=extend.right, text=nm, text_size=size.tiny, text_color=cTx)
            array.push(zId, id)
            array.push(zDir, 1)
            array.push(zTop, lA)
            array.push(zBot, hB)
            array.push(zTap, -1)
            array.push(zBox, nb)
            added := true
        // Bearish gap: high of newest candle below low of the candle 2 before it
        if hA < lB and (lB - hA) >= minG
            box nb = na
            if draw
                nb := box.new(bar_index, lB, bar_index + 1, hA, border_color=cRB, bgcolor=cRF, extend=extend.right, text=nm, text_size=size.tiny, text_color=cTx)
            array.push(zId, id)
            array.push(zDir, -1)
            array.push(zTop, lB)
            array.push(zBot, hA)
            array.push(zTap, -1)
            array.push(zBox, nb)
            added := true
        if added
            int cnt = 0
            for i = 0 to array.size(zId) - 1
                if array.get(zId, i) == id
                    cnt += 1
            if cnt > maxZ
                for i = 0 to array.size(zId) - 1
                    if array.get(zId, i) == id
                        box.delete(array.get(zBox, i))
                        array.remove(zId, i)
                        array.remove(zDir, i)
                        array.remove(zTop, i)
                        array.remove(zBot, i)
                        array.remove(zTap, i)
                        array.remove(zBox, i)
                        break
    true

// ── A) PO3 HTF CANDLE PROJECTION ─────────────────────────────────────────────
bool po3OK  = showPO3 and timeframe.in_seconds(po3TF) > chartSec
int  po3T   = nz(time(po3TF), 0)
bool po3New = po3T != nz(po3T[1], 0)
int  po3CloseT = nz(time_close(po3TF), po3T + timeframe.in_seconds(po3TF) * 1000)

var float   po3O = na
var float   po3H = na
var float   po3L = na
var float   po3C = na
var int     po3Ts = 0
var int     po3StartBar = 0
var float[] po3HistO = array.new_float()
var float[] po3HistH = array.new_float()
var float[] po3HistL = array.new_float()
var float[] po3HistC = array.new_float()
var int[]   po3HistT = array.new_int()

if po3OK
    if po3New
        if not na(po3O)
            array.push(po3HistO, po3O)
            array.push(po3HistH, po3H)
            array.push(po3HistL, po3L)
            array.push(po3HistC, po3C)
            array.push(po3HistT, po3Ts)
            if array.size(po3HistO) > 12
                array.shift(po3HistO)
                array.shift(po3HistH)
                array.shift(po3HistL)
                array.shift(po3HistC)
                array.shift(po3HistT)
        po3O := open
        po3H := high
        po3L := low
        po3C := close
        po3Ts := po3T
        po3StartBar := bar_index
    else if not na(po3O)
        po3H := math.max(po3H, high)
        po3L := math.min(po3L, low)
        po3C := close

var box[]   po3Boxes  = array.new_box()
var line[]  po3Lines  = array.new_line()
var label[] po3Labels = array.new_label()

if barstate.islast
    while array.size(po3Boxes) > 0
        box.delete(array.pop(po3Boxes))
    while array.size(po3Lines) > 0
        line.delete(array.pop(po3Lines))
    while array.size(po3Labels) > 0
        label.delete(array.pop(po3Labels))

    if po3OK and not na(po3O)
        string tfTxt  = f_tfName(po3TF)
        int    nDone  = math.min(po3Count - 1, array.size(po3HistO))
        int    total  = nDone + 1
        int    stepX  = po3Width + po3Gap
        int    lastX1 = bar_index + po3Offset + (total - 1) * stepX + po3Width
        int    nowT   = barstate.isrealtime ? timenow : time_close
        int    remSec = math.max(0, math.floor((po3CloseT - nowT) / 1000))

        for i = 0 to total - 1
            bool  forming = i == total - 1
            float vo = na
            float vh = na
            float vl = na
            float vc = na
            int   vt = 0
            if forming
                vo := po3O
                vh := po3H
                vl := po3L
                vc := po3C
                vt := po3Ts
            else
                int idx = array.size(po3HistO) - nDone + i
                vo := array.get(po3HistO, idx)
                vh := array.get(po3HistH, idx)
                vl := array.get(po3HistL, idx)
                vc := array.get(po3HistC, idx)
                vt := array.get(po3HistT, idx)

            int   x0  = bar_index + po3Offset + i * stepX
            int   x1  = x0 + po3Width
            int   xm  = x0 + math.floor(po3Width / 2)
            bool  upC     = vc >= vo
            color colBody = upC ? cPo3UpBody : cPo3DnBody
            color colBrd  = upC ? cPo3UpBorder : cPo3DnBorder
            color colWick = upC ? cPo3UpWick : cPo3DnWick

            array.push(po3Lines, line.new(xm, vh, xm, vl, xloc=xloc.bar_index, color=colWick, width=1))
            array.push(po3Boxes, box.new(x0, math.max(vo, vc), x1, math.min(vo, vc), xloc=xloc.bar_index, border_color=colBrd, border_width=1, bgcolor=colBody))

            if not forming and po3ShowTimer
                array.push(po3Labels, label.new(xm, vl, str.format_time(vt, "HH:mm", po3TZ), xloc=xloc.bar_index, style=label.style_label_up, color=color.new(color.gray, 100), textcolor=cPo3TimeTxt, size=size.tiny))

            if forming
                string rowTxt = tfTxt + " PO3"
                if po3ShowTimer
                    rowTxt += "\nCloses " + str.format_time(po3CloseT, "HH:mm", po3TZ) + "  |  " + f_fmtRem(remSec)
                if po3ShowRange
                    rowTxt += "\nRange: " + str.tostring(vh - vl, "#.##") + " pts"
                array.push(po3Labels, label.new(x1 + 1, vc, rowTxt, xloc=xloc.bar_index, style=label.style_label_left, color=cPo3LblBg, textcolor=cPo3LblTxt, size=size.small))

        if po3ShowOpen
            array.push(po3Lines, line.new(po3StartBar, po3O, lastX1, po3O, xloc=xloc.bar_index, color=cPo3Open, style=line.style_dotted, width=1))

// ── B) 1m CISD AFTER A RIBBON PULLBACK ───────────────────────────────────────
bool  cisdActive = showCISD and timeframe.in_seconds(cisdTF) <= chartSec
int   winMs      = cisdWindow * chartSec * 1000

// Type A (shallow): price recently beyond the 1st band AND Trend >= threshold -> ribbon pullback only (EMA 8 touch)
// Type B (deep): everything else -> pullback must reach the deep line (EMA 21 / EMA 55)
bool  beyondUp    = close > upper1
bool  beyondDn    = close < lower1
bool  extUpRecent = ta.highest(beyondUp ? 1.0 : 0.0, cisdExtBars) > 0
bool  extDnRecent = ta.highest(beyondDn ? 1.0 : 0.0, cisdExtBars) > 0
bool  shallowL    = bullTrend and adxVal >= cisdAdxMin and extUpRecent
bool  shallowS    = bearTrend and adxVal >= cisdAdxMin and extDnRecent
float trigL       = shallowL ? ema8 : math.max(ema21, ema55)
float trigS       = shallowS ? ema8 : math.min(ema21, ema55)

// Chart-timeframe candle body must CLOSE OUTSIDE the ribbon (beyond EMA 8 / 21 / 55), judged on the closed candle
float ribTop  = math.max(ema8, math.max(ema21, ema55))
float ribBot  = math.min(ema8, math.min(ema21, ema55))
float outRefL = outMode == "Close" ? close : math.min(open, close)
float outRefS = outMode == "Close" ? close : math.max(open, close)
bool  outL    = bullTrend and outRefL > ribTop
bool  outS    = bearTrend and outRefS < ribBot
var int outLTime = 0
var int outSTime = 0
if barstate.isconfirmed
    if outL
        outLTime := time_close
    if outS
        outSTime := time_close

[iO, iC, iH, iL, iT] = request.security_lower_tf(syminfo.tickerid, cisdTF, [open, close, high, low, time], ignore_invalid_timeframe=true)

var float cisdBearLvl  = na   // pending level: close above it = bullish CISD
var int   cisdBearLvlT = 0
var float cisdBullLvl  = na   // pending level: close below it = bearish CISD
var int   cisdBullLvlT = 0
var float cisdBearRunO = na
var float cisdBullRunO = na
var int   cisdBearRun  = 0
var int   cisdBullRun  = 0
var int   cisdBullT    = 0
var int   cisdBearT    = 0
var float cisdBullL    = na
var float cisdBearL    = na
var int   touchLT      = 0
var int   touchST      = 0
var int   touchTypeL   = 0   // 1 = Type A (shallow), 2 = Type B (deep)
var int   touchTypeS   = 0
var float q1o = na
var float q1h = na
var float q1l = na
var float q1c = na
var float q2o = na
var float q2h = na
var float q2l = na
var float q2c = na
var float q3o = na
var float q3h = na
var float q3l = na
var float q3c = na
var float q4o = na
var float q4h = na
var float q4l = na
var float q4c = na
var float avgBody1m = na
var float avgRng1m  = na
var int    patBullT = 0
var int    patBearT = 0
var string patBullName = ""
var string patBearName = ""

if cisdActive
    if array.size(iC) > 0
        for j = 0 to array.size(iC) - 1
            float xo = array.get(iO, j)
            float xc = array.get(iC, j)
            float xh = array.get(iH, j)
            float xl = array.get(iL, j)
            int   xt = array.get(iT, j)

            // 0) 1m candlestick patterns completing on THIS 1m candle
            float xb = math.abs(xc - xo)
            float xr = xh - xl
            avgBody1m := nz(avgBody1m, xb) + (xb - nz(avgBody1m, xb)) / 14.0
            avgRng1m  := nz(avgRng1m, xr) + (xr - nz(avgRng1m, xr)) / 14.0
            string pnL = f_pat(true, xo, xh, xl, xc, q1o, q1h, q1l, q1c, q2o, q2h, q2l, q2c, q3o, q3h, q3l, q3c, q4o, q4h, q4l, q4c, avgBody1m, 0.1 * avgRng1m, patSingle, patDouble, patTriple, patMulti, rejWick, rejBody, patLong, patSmall)
            string pnS = f_pat(false, xo, xh, xl, xc, q1o, q1h, q1l, q1c, q2o, q2h, q2l, q2c, q3o, q3h, q3l, q3c, q4o, q4h, q4l, q4c, avgBody1m, 0.1 * avgRng1m, patSingle, patDouble, patTriple, patMulti, rejWick, rejBody, patLong, patSmall)

            // 1) Pullback touch (with the trend): shallow regime = EMA 8, deep regime = EMA 21 / 55
            if bullTrend and xl <= trigL
                touchLT := xt
                touchTypeL := shallowL ? 1 : 2
            if bearTrend and xh >= trigS
                touchST := xt
                touchTypeS := shallowS ? 1 : 2

            // 2) Drop stale pending levels
            if not na(cisdBearLvl) and xt - cisdBearLvlT > winMs
                cisdBearLvl := na
            if not na(cisdBullLvl) and xt - cisdBullLvlT > winMs
                cisdBullLvl := na

            // 3) CISD check against levels set by earlier candles
            if not na(cisdBearLvl) and xc > cisdBearLvl
                cisdBullT := xt
                cisdBullL := cisdBearLvl
                cisdBearLvl := na
                if pnL != ""
                    patBullT := xt
                    patBullName := pnL
            if not na(cisdBullLvl) and xc < cisdBullLvl
                cisdBearT := xt
                cisdBearL := cisdBullLvl
                cisdBullLvl := na
                if pnS != ""
                    patBearT := xt
                    patBearName := pnS

            // 4) Track consecutive delivery runs
            if xc < xo
                cisdBearRun += 1
                if cisdBearRun == 1
                    cisdBearRunO := xo
                if cisdBearRun >= cisdMinRun
                    cisdBearLvl := cisdBearRunO
                    cisdBearLvlT := xt
                cisdBullRun := 0
            else if xc > xo
                cisdBullRun += 1
                if cisdBullRun == 1
                    cisdBullRunO := xo
                if cisdBullRun >= cisdMinRun
                    cisdBullLvl := cisdBullRunO
                    cisdBullLvlT := xt
                cisdBearRun := 0

            // 5) Shift the 1m candle history
            q4o := q3o
            q4h := q3h
            q4l := q3l
            q4c := q3c
            q3o := q2o
            q3h := q2h
            q3l := q2l
            q3c := q2c
            q2o := q1o
            q2h := q1h
            q2l := q1l
            q2c := q1c
            q1o := xo
            q1h := xh
            q1l := xl
            q1c := xc

bool touchRecL = touchLT > 0 and (time - touchLT) <= winMs
bool touchRecS = touchST > 0 and (time - touchST) <= winMs
bool needRejL  = (touchTypeL == 2 and cisdReqRej) or (touchTypeL == 1 and cisdReqRejA)
bool needRejS  = (touchTypeS == 2 and cisdReqRej) or (touchTypeS == 1 and cisdReqRejA)
bool cisdGotL  = cisdActive and touchLT > 0 and cisdBullT >= touchLT
bool cisdGotS  = cisdActive and touchST > 0 and cisdBearT >= touchST
bool patGotL   = cisdActive and touchLT > 0 and patBullT >= touchLT
bool outGotL   = touchLT > 0 and outLTime > touchLT
bool patGotS   = cisdActive and touchST > 0 and patBearT >= touchST
bool outGotS   = touchST > 0 and outSTime > touchST
bool cisdLongOK  = cisdActive and bullTrend and touchRecL and (needRejL ? (patGotL and outGotL) : cisdGotL)
bool cisdShortOK = cisdActive and bearTrend and touchRecS and (needRejS ? (patGotS and outGotS) : cisdGotS)
bool cisdWaitL   = cisdActive and bullTrend and touchRecL and not cisdLongOK
bool cisdWaitS   = cisdActive and bearTrend and touchRecS and not cisdShortOK
bool cisdLongNew  = cisdLongOK and not nz(cisdLongOK[1], false)
bool cisdShortNew = cisdShortOK and not nz(cisdShortOK[1], false)
int  doneL = needRejL ? math.max(patBullT, outLTime) : cisdBullT
int  doneS = needRejS ? math.max(patBearT, outSTime) : cisdBearT
int  cisdAgeL = math.max(0, math.round((time_close - doneL) / 60000.0))
int  cisdAgeS = math.max(0, math.round((time_close - doneS) / 60000.0))

// ── C) HTF FVG DELIVERY (unfilled / un-inversed FVGs on 15m → D) ────────────
bool htfFillWick = htfFill == "Wick"
bool htfBodyMode = not htfFillWick
bool htfOk1 = showHTF and htfOn1 and timeframe.in_seconds(htfTF1) > chartSec
bool htfOk2 = showHTF and htfOn2 and timeframe.in_seconds(htfTF2) > chartSec
bool htfOk3 = showHTF and htfOn3 and timeframe.in_seconds(htfTF3) > chartSec
bool htfOk4 = showHTF and htfOn4 and timeframe.in_seconds(htfTF4) > chartSec
bool htfOk5 = showHTF and htfOn5 and timeframe.in_seconds(htfTF5) > chartSec

// Last 3 completed HTF candles (non-repainting): [1] = newest completed, [3] = oldest of the three
[hA1, lA1, hB1, lB1, cL1] = request.security(syminfo.tickerid, htfTF1, [high[1], low[1], high[3], low[3], close[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[hA2, lA2, hB2, lB2, cL2] = request.security(syminfo.tickerid, htfTF2, [high[1], low[1], high[3], low[3], close[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[hA3, lA3, hB3, lB3, cL3] = request.security(syminfo.tickerid, htfTF3, [high[1], low[1], high[3], low[3], close[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[hA4, lA4, hB4, lB4, cL4] = request.security(syminfo.tickerid, htfTF4, [high[1], low[1], high[3], low[3], close[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[hA5, lA5, hB5, lB5, cL5] = request.security(syminfo.tickerid, htfTF5, [high[1], low[1], high[3], low[3], close[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)

var int[]    hzId  = array.new_int()
var int[]    hzDir = array.new_int()
var float[]  hzTop = array.new_float()
var float[]  hzBot = array.new_float()
var int[]    hzTap = array.new_int()
var box[]    hzBox = array.new_box()
var string[] htfNames = array.from(f_tfName(htfTF1), f_tfName(htfTF2), f_tfName(htfTF3), f_tfName(htfTF4), f_tfName(htfTF5))
var int[]    htfSecs  = array.from(timeframe.in_seconds(htfTF1), timeframe.in_seconds(htfTF2), timeframe.in_seconds(htfTF3), timeframe.in_seconds(htfTF4), timeframe.in_seconds(htfTF5))

f_htfAdd(htfOk1, htfTF1, 0, array.get(htfNames, 0), hA1, lA1, hB1, lB1, hzId, hzDir, hzTop, hzBot, hzTap, hzBox, htfDraw, htfMaxZones, cHtfBullFill, cHtfBullBrd, cHtfBearFill, cHtfBearBrd, cHtfBoxTxt, cL1, htfBodyMode)
f_htfAdd(htfOk2, htfTF2, 1, array.get(htfNames, 1), hA2, lA2, hB2, lB2, hzId, hzDir, hzTop, hzBot, hzTap, hzBox, htfDraw, htfMaxZones, cHtfBullFill, cHtfBullBrd, cHtfBearFill, cHtfBearBrd, cHtfBoxTxt, cL2, htfBodyMode)
f_htfAdd(htfOk3, htfTF3, 2, array.get(htfNames, 2), hA3, lA3, hB3, lB3, hzId, hzDir, hzTop, hzBot, hzTap, hzBox, htfDraw, htfMaxZones, cHtfBullFill, cHtfBullBrd, cHtfBearFill, cHtfBearBrd, cHtfBoxTxt, cL3, htfBodyMode)
f_htfAdd(htfOk4, htfTF4, 3, array.get(htfNames, 3), hA4, lA4, hB4, lB4, hzId, hzDir, hzTop, hzBot, hzTap, hzBox, htfDraw, htfMaxZones, cHtfBullFill, cHtfBullBrd, cHtfBearFill, cHtfBearBrd, cHtfBoxTxt, cL4, htfBodyMode)
f_htfAdd(htfOk5, htfTF5, 4, array.get(htfNames, 4), hA5, lA5, hB5, lB5, hzId, hzDir, hzTop, hzBot, hzTap, hzBox, htfDraw, htfMaxZones, cHtfBullFill, cHtfBullBrd, cHtfBearFill, cHtfBearBrd, cHtfBoxTxt, cL5, htfBodyMode)

// Update every stored zone: kill filled/inversed ones and record the last bar price was inside each gap
if array.size(hzId) > 0
    for i = array.size(hzId) - 1 to 0
        int   zd = array.get(hzDir, i)
        float zt = array.get(hzTop, i)
        float zb = array.get(hzBot, i)
        bool  dead = false
        if zd == 1
            dead := htfFillWick and low <= zb
            if not dead and low <= zt
                array.set(hzTap, i, bar_index)
        else
            dead := htfFillWick and high >= zt
            if not dead and high >= zb
                array.set(hzTap, i, bar_index)

        if dead
            box.delete(array.get(hzBox, i))
            array.remove(hzId, i)
            array.remove(hzDir, i)
            array.remove(hzTop, i)
            array.remove(hzBot, i)
            array.remove(hzTap, i)
            array.remove(hzBox, i)


// ═══════════════════════════════════════════════════════════════════════════════
// SL / TP PROJECTION LINES (drawn on entry signal bars)
// ═══════════════════════════════════════════════════════════════════════════════
var line slLine = na
var line tpLine = na
var label entryLabel = na

// Clean up previous drawings on new signal
if sigLong or sigShort
    line.delete(slLine)
    line.delete(tpLine)
    label.delete(entryLabel)

if showSLTP and sigLong
    float slDist   = nz(atrVal, 10.0) * atrSlMult
    float entrySL  = close - slDist
    float entryTP  = close + slDist * trendRR
    slLine := line.new(bar_index, entrySL, bar_index + 20, entrySL, color=color.new(color.red, 20), width=2, style=line.style_dashed)
    tpLine := line.new(bar_index, entryTP, bar_index + 20, entryTP, color=color.new(color.green, 20), width=2, style=line.style_dashed)
    entryLabel := label.new(bar_index, close, "▲ LONG\nSL: " + str.tostring(entrySL, "#.##") + "\nTP: " + str.tostring(entryTP, "#.##"),
         color=color.new(color.teal, 20), textcolor=color.new(color.white, 0), style=label.style_label_up, size=size.small)

if showSLTP and sigShort
    float slDist   = nz(atrVal, 10.0) * atrSlMult
    float entrySL  = close + slDist
    float entryTP  = close - slDist * trendRR
    slLine := line.new(bar_index, entrySL, bar_index + 20, entrySL, color=color.new(color.red, 20), width=2, style=line.style_dashed)
    tpLine := line.new(bar_index, entryTP, bar_index + 20, entryTP, color=color.new(color.green, 20), width=2, style=line.style_dashed)
    entryLabel := label.new(bar_index, close, "▼ SHORT\nSL: " + str.tostring(entrySL, "#.##") + "\nTP: " + str.tostring(entryTP, "#.##"),
         color=color.new(color.red, 20), textcolor=color.new(color.white, 0), style=label.style_label_down, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// CONFLUENCE SCORE DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════
int score = 0

// 1. Trending regime
if isTrending
    score += 1

// 2. EMA ribbon aligned
if bullTrend or bearTrend
    score += 1

// 3. Inside active session
if inFullRTH
    score += 1

// 4. Has active FVGs
bool hasFVG = array.size(fvgBox) > 0
if hasFVG
    score += 1

// 5. Near key session level
float nearDist = nz(atrVal, 10.0) * 0.5
bool nearPDH = not na(pdh) and math.abs(close - pdh) <= nearDist
bool nearPDL = not na(pdl) and math.abs(close - pdl) <= nearDist
bool nearPDC = not na(pdc) and math.abs(close - pdc) <= nearDist
bool nearONH = not na(frozenONH) and math.abs(close - frozenONH) <= nearDist
bool nearONL = not na(frozenONL) and math.abs(close - frozenONL) <= nearDist
bool nearLevel = nearPDH or nearPDL or nearPDC or nearONH or nearONL
if nearLevel
    score += 1

// 6. Pullback recently happened
if pbLongRecent or pbShortRecent
    score += 1

string bias   = bullTrend and close > vwapLine ? "BULLISH" : bearTrend and close < vwapLine ? "BEARISH" : "NEUTRAL"
string regime = isTrending ? "TREND" : "RANGE"

// --- Dashboard Table ---
var table dash = table.new(position.top_right, 2, 15,
     bgcolor=color.new(color.black, 20), frame_color=color.new(color.gray, 60), frame_width=1,
     border_color=color.new(color.gray, 80), border_width=1)

if barstate.islast and showDash
    // Header row
    table.cell(dash, 0, 0, " ARSENAL ", text_color=color.new(color.white, 0), text_size=size.small, bgcolor=color.new(color.blue, 50))
    table.cell(dash, 1, 0, str.tostring(score) + " / 6", text_color=color.new(color.white, 0), text_size=size.small,
         bgcolor=score >= 4 ? color.new(color.teal, 30) : score >= 3 ? color.new(color.orange, 40) : color.new(color.red, 40))

    // Row 1: ENTRY SIGNAL (most important row)
    table.cell(dash, 0, 1, "SIGNAL", text_color=color.new(color.gray, 20), text_size=size.tiny)
    string sigTxt = sigLong ? "▲ GO LONG" : sigShort ? "▼ GO SHORT" : "— WAIT —"
    color  sigBg  = sigLong ? color.new(color.teal, 20) : sigShort ? color.new(color.red, 20) : color.new(color.gray, 70)
    table.cell(dash, 1, 1, sigTxt, text_color=color.new(color.white, 0), text_size=size.small, bgcolor=sigBg)

    // Row 2: VWAP
    table.cell(dash, 0, 2, "VWAP", text_color=color.new(color.gray, 20), text_size=size.tiny)
    string vwapTxt = close >= upper2 ? "▼ +2σ" : close >= upper1 ? "+1σ" : close <= lower2 ? "▲ -2σ" : close <= lower1 ? "-1σ" : close > vwapLine ? "Above" : "Below"
    color  vwapBg  = (close >= upper2 or close <= lower2) ? color.new(color.orange, 30) : color.new(color.gray, 70)
    table.cell(dash, 1, 2, vwapTxt, text_color=color.new(color.white, 0), text_size=size.tiny, bgcolor=vwapBg)

    // Row 3: Trend
    table.cell(dash, 0, 3, "TREND", text_color=color.new(color.gray, 20), text_size=size.tiny)
    string trendTxt = bullTrend ? "BULL ▲" : bearTrend ? "BEAR ▼" : "FLAT ═"
    color  trendBg  = bullTrend ? color.new(color.teal, 40) : bearTrend ? color.new(color.red, 40) : color.new(color.gray, 70)
    table.cell(dash, 1, 3, trendTxt, text_color=color.new(color.white, 0), text_size=size.tiny, bgcolor=trendBg)

    // Row 4: ADX / Regime
    table.cell(dash, 0, 4, "REGIME", text_color=color.new(color.gray, 20), text_size=size.tiny)
    color regBg = isTrending ? color.new(color.orange, 40) : color.new(color.gray, 70)
    table.cell(dash, 1, 4, regime + " (" + str.tostring(math.round(adxVal)) + ")", text_color=color.new(color.white, 0), text_size=size.tiny, bgcolor=regBg)

    // Row 5: RSI
    table.cell(dash, 0, 5, "RSI", text_color=color.new(color.gray, 20), text_size=size.tiny)
    color rsiBg = rsiVal > 70 ? color.new(color.red, 40) : rsiVal < 30 ? color.new(color.teal, 40) : color.new(color.gray, 70)
    table.cell(dash, 1, 5, str.tostring(math.round(rsiVal)), text_color=color.new(color.white, 0), text_size=size.tiny, bgcolor=rsiBg)

    // Row 6: Pullback
    table.cell(dash, 0, 6, "PULLBACK", text_color=color.new(color.gray, 20), text_size=size.tiny)
    string pbTxt = pbLongRecent and bullTrend ? "READY ▲" : pbShortRecent and bearTrend ? "READY ▼" : "NONE"
    color  pbBg  = (pbLongRecent and bullTrend) or (pbShortRecent and bearTrend) ? color.new(color.teal, 40) : color.new(color.gray, 70)
    table.cell(dash, 1, 6, pbTxt, text_color=color.new(color.white, 0), text_size=size.tiny, bgcolor=pbBg)

    // Row 7: Kill Zone
    table.cell(dash, 0, 7, "SESSION", text_color=color.new(color.gray, 20), text_size=size.tiny)
    string kzTxt = inNYOpen ? "NY OPEN" : inPowerHour ? "PWR HOUR" : inFullRTH ? "RTH" : "CLOSED"
    color  kzBg  = inNYOpen or inPowerHour ? color.new(color.blue, 40) : inFullRTH ? color.new(color.blue, 70) : color.new(color.gray, 70)
    table.cell(dash, 1, 7, kzTxt, text_color=color.new(color.white, 0), text_size=size.tiny, bgcolor=kzBg)

    // Row 8: FVG
    table.cell(dash, 0, 8, "FVG", text_color=color.new(color.gray, 20), text_size=size.tiny)
    string fvgTxt = hasFVG ? str.tostring(array.size(fvgBox)) + " ACTIVE" : "NONE"
    color  fvgBg  = hasFVG ? color.new(color.purple, 40) : color.new(color.gray, 70)
    table.cell(dash, 1, 8, fvgTxt, text_color=color.new(color.white, 0), text_size=size.tiny, bgcolor=fvgBg)

    // Row 9: Key Level
    table.cell(dash, 0, 9, "KEY LEVEL", text_color=color.new(color.gray, 20), text_size=size.tiny)
    string slTxt = nearLevel ? "NEARBY" : "—"
    color  slBg  = nearLevel ? color.new(color.yellow, 40) : color.new(color.gray, 70)
    table.cell(dash, 1, 9, slTxt, text_color=color.new(color.white, 0), text_size=size.tiny, bgcolor=slBg)

    // Row 10: Bias
    table.cell(dash, 0, 10, " BIAS ", text_color=color.new(color.gray, 20), text_size=size.tiny)
    color biasBg = bias == "BULLISH" ? color.new(color.teal, 30) : bias == "BEARISH" ? color.new(color.red, 30) : color.new(color.gray, 60)
    table.cell(dash, 1, 10, bias, text_color=color.new(color.white, 0), text_size=size.small, bgcolor=biasBg)

    // Row 11: 1m CISD after ribbon pullback
    table.cell(dash, 0, 11, "1m CISD", text_color=color.new(color.gray, 20), text_size=size.tiny)
    string tagL = touchTypeL == 1 ? "A" : "B"
    string tagS = touchTypeS == 1 ? "A" : "B"
    string waitL = not needRejL ? "▲ " + tagL + " in ribbon…" : patGotL ? "▲ " + tagL + " " + patBullName + " CISD ✓ need close" : outGotL ? (cisdGotL ? "▲ " + tagL + " close ✓ CISD w/o pattern" : "▲ " + tagL + " close ✓ need pattern CISD") : cisdGotL ? "▲ " + tagL + " CISD w/o pattern" : "▲ " + tagL + " in zone…"
    string waitS = not needRejS ? "▼ " + tagS + " in ribbon…" : patGotS ? "▼ " + tagS + " " + patBearName + " CISD ✓ need close" : outGotS ? (cisdGotS ? "▼ " + tagS + " close ✓ CISD w/o pattern" : "▼ " + tagS + " close ✓ need pattern CISD") : cisdGotS ? "▼ " + tagS + " CISD w/o pattern" : "▼ " + tagS + " in zone…"
    string idleL = shallowL ? "▲ wait A: EMA8" : "▲ wait B: EMA21/55"
    string idleS = shallowS ? "▼ wait A: EMA8" : "▼ wait B: EMA21/55"
    string cisdTxt = not cisdActive ? "OFF" : cisdLongOK ? "▲ " + tagL + " ✓ " + (needRejL ? patBullName + " " : "") + str.tostring(cisdAgeL) + "m ago" : cisdShortOK ? "▼ " + tagS + " ✓ " + (needRejS ? patBearName + " " : "") + str.tostring(cisdAgeS) + "m ago" : cisdWaitL ? waitL : cisdWaitS ? waitS : bullTrend ? idleL : bearTrend ? idleS : "—"
    color  cisdBg  = cisdLongOK ? cCisdOnL : cisdShortOK ? cCisdOnS : (cisdWaitL or cisdWaitS) ? cCisdWait : cCisdIdle
    table.cell(dash, 1, 11, cisdTxt, text_color=cCisdTxt, text_size=size.tiny, bgcolor=cisdBg)

    // Rows 12-13: HTF FVG accelerators. NOW = valid gap price was most recently inside, PREV = the one before it
    int accA = -1
    int accB = -1
    if showHTF and array.size(hzId) > 0
        for i = 0 to array.size(hzId) - 1
            int tpI = array.get(hzTap, i)
            if tpI >= 0 and (bar_index - tpI) <= htfAccBars
                bool sideOk = array.get(hzDir, i) == 1 ? close >= array.get(hzBot, i) : close <= array.get(hzTop, i)
                if sideOk
                    if accA < 0
                        accA := i
                    else if f_accBetter(hzTap, hzId, htfSecs, i, accA)
                        accB := accA
                        accA := i
                    else if accB < 0
                        accB := i
                    else if f_accBetter(hzTap, hzId, htfSecs, i, accB)
                        accB := i

    int    accDirA = 0
    int    accDirB = 0
    string accTxtA = "— NONE"
    string accTxtB = "— NONE"
    color  accBgA  = cHtfNone
    color  accBgB  = cHtfNone
    if accA >= 0
        accDirA := array.get(hzDir, accA)
        float lvlA = accDirA == 1 ? array.get(hzTop, accA) : array.get(hzBot, accA)
        accTxtA := (accDirA == 1 ? "▲ " : "▼ ") + array.get(htfNames, array.get(hzId, accA)) + " " + str.tostring(lvlA, "#.##")
        bool alA = (accDirA == 1 and bias == "BULLISH") or (accDirA == -1 and bias == "BEARISH")
        accBgA := alA ? (accDirA == 1 ? cHtfBull : cHtfBear) : cHtfMix
    if accB >= 0
        accDirB := array.get(hzDir, accB)
        float lvlB = accDirB == 1 ? array.get(hzTop, accB) : array.get(hzBot, accB)
        accTxtB := (accDirB == 1 ? "▲ " : "▼ ") + array.get(htfNames, array.get(hzId, accB)) + " " + str.tostring(lvlB, "#.##")
        bool alB = (accDirB == 1 and bias == "BULLISH") or (accDirB == -1 and bias == "BEARISH")
        accBgB := alB ? (accDirB == 1 ? cHtfBull : cHtfBear) : cHtfMix
    table.cell(dash, 0, 12, "FVG NOW", text_color=color.new(color.gray, 20), text_size=size.tiny)
    table.cell(dash, 1, 12, showHTF ? accTxtA : "OFF", text_color=cHtfTxt, text_size=size.tiny, bgcolor=accBgA)
    table.cell(dash, 0, 13, "FVG PREV", text_color=color.new(color.gray, 20), text_size=size.tiny)
    table.cell(dash, 1, 13, showHTF ? accTxtB : "OFF", text_color=cHtfTxt, text_size=size.tiny, bgcolor=accBgB)

    // Row 14: EXTRA confluences (separate from the original 6-point score above)
    bool xCisd = cisdLongOK or cisdShortOK
    bool xFvg  = accA >= 0 and ((accDirA == 1 and bias == "BULLISH") or (accDirA == -1 and bias == "BEARISH"))
    bool xPo3  = po3OK and not na(po3O) and ((bias == "BULLISH" and po3C > po3O) or (bias == "BEARISH" and po3C < po3O))
    int  xN    = (xCisd ? 1 : 0) + (xFvg ? 1 : 0) + (xPo3 ? 1 : 0)
    string xTxt = str.tostring(xN) + " / 3" + (xCisd ? "  CISD" : "") + (xFvg ? "  FVG" : "") + (xPo3 ? "  PO3" : "")
    color  xBg  = xN == 3 ? cExtraFull : xN > 0 ? cExtraPart : cExtraNone
    table.cell(dash, 0, 14, "EXTRA", text_color=color.new(color.gray, 20), text_size=size.tiny)
    table.cell(dash, 1, 14, xTxt, text_color=cExtraTxt, text_size=size.tiny, bgcolor=xBg)

// ═══════════════════════════════════════════════════════════════════════════════
// PLOTS — All outside if blocks (Rule 4)
// ═══════════════════════════════════════════════════════════════════════════════

// --- VWAP + Bands ---
pVwap = plot(showVWAP ? vwapLine : na, "VWAP", color=color.new(color.white, 20), linewidth=2)
pU1   = plot(showVWAP ? upper1 : na, "+1σ", color=color.new(color.blue, 60), linewidth=1)
pU2   = plot(showVWAP ? upper2 : na, "+2σ", color=color.new(color.blue, 40), linewidth=1)
pL1   = plot(showVWAP ? lower1 : na, "-1σ", color=color.new(color.blue, 60), linewidth=1)
pL2   = plot(showVWAP ? lower2 : na, "-2σ", color=color.new(color.blue, 40), linewidth=1)

fill(pU1, pL1, color=showVWAP ? color.new(color.blue, 93) : na, title="VWAP ±1σ")
fill(pU2, pU1, color=showVWAP ? color.new(color.blue, 96) : na, title="VWAP +1σ→+2σ")
fill(pL1, pL2, color=showVWAP ? color.new(color.blue, 96) : na, title="VWAP -1σ→-2σ")

// --- Session Levels ---
plot(showSL ? pdh : na, "PDH", color=color.new(color.red, 20), style=plot.style_line, linewidth=1)
plot(showSL ? pdl : na, "PDL", color=color.new(color.green, 20), style=plot.style_line, linewidth=1)
plot(showSL ? pdc : na, "PDC", color=color.new(color.orange, 30), style=plot.style_line, linewidth=1)
plot(showSL ? frozenONH : na, "ON High", color=color.new(color.blue, 30), style=plot.style_line, linewidth=1)
plot(showSL ? frozenONL : na, "ON Low", color=color.new(color.aqua, 30), style=plot.style_line, linewidth=1)

// --- EMA Ribbon ---
pE8  = plot(showEMA ? ema8  : na, "EMA 8",  color=color.new(color.yellow, 30), linewidth=1)
pE21 = plot(showEMA ? ema21 : na, "EMA 21", color=color.new(color.orange, 30), linewidth=1)
pE55 = plot(showEMA ? ema55 : na, "EMA 55", color=color.new(color.red, 20),    linewidth=2)

color ribbonFill = bullTrend ? color.new(color.teal, 88) : bearTrend ? color.new(color.red, 88) : na
fill(pE8, pE55, color=showEMA ? ribbonFill : na, title="EMA Ribbon")

// --- Session Backgrounds ---
bgcolor(showKZ and inNYOpen    ? color.new(color.blue, 95) : na, title="NY Open")
bgcolor(showKZ and inPowerHour ? color.new(color.purple, 95) : na, title="Power Hour")

// --- Entry Arrows ---
plotshape(sigLong,  title="Long Signal",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.teal, 0), size=size.small, text="LONG")
plotshape(sigShort, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),  size=size.small, text="SHORT")

// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════
alertcondition(sigLong,  title="Trend Pullback Long",  message="▲ LONG signal on {{ticker}} — Trend pullback entry. Check Arsenal dashboard.")
alertcondition(sigShort, title="Trend Pullback Short", message="▼ SHORT signal on {{ticker}} — Trend pullback entry. Check Arsenal dashboard.")
alertcondition(score >= 4, title="High Confluence ≥4",  message="HIGH confluence on {{ticker}} — score ≥4, prime setup!")
alertcondition(cisdLongNew,  title="1m CISD Long after ribbon",  message="▲ 1m CISD after ribbon pullback on {{ticker}}")
alertcondition(cisdShortNew, title="1m CISD Short after ribbon", message="▼ 1m CISD after ribbon pullback on {{ticker}}")
